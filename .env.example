# Things FastMCP Server Configuration
# Copy this file to .env and modify the values as needed

# Server binding configuration
# Default: 127.0.0.1 (localhost only)
# Use 0.0.0.0 to allow remote connections
THINGS_FASTMCP_HOST=127.0.0.1

# Server port configuration
# Default: 8009
# Use any available port number
THINGS_FASTMCP_PORT=8009

# Example configurations:
# For remote access:
# THINGS_FASTMCP_HOST=0.0.0.0
# THINGS_FASTMCP_PORT=9000

# For custom port only:
# THINGS_FASTMCP_PORT=8080

# OAuth 2.1 Authentication (optional)
# If both CLIENT_ID and CLIENT_SECRET are set, OAuth endpoints will be enabled
# This is required for ChatGPT custom apps and other OAuth-based MCP clients
# Leave empty to disable authentication (default)
# ⚠️  IMPORTANT: Use HTTPS/TLS when exposing to the internet!

# Your pre-configured OAuth client credentials
# Enter these SAME values in ChatGPT's custom app "OAuth Client ID" and "OAuth Client Secret" fields
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# OAuth issuer URL (optional - auto-detected from host/port if not set)
# For local testing: http://localhost:8009 or http://127.0.0.1:8009
# For production: https://your-domain.com
# OAUTH_ISSUER_URL=

# Example configuration for ChatGPT:
# 1. Generate random credentials:
#    OAUTH_CLIENT_ID=$(uuidgen)
#    OAUTH_CLIENT_SECRET=$(openssl rand -base64 32)
# 2. Copy these values to ChatGPT's "OAuth Client ID" and "OAuth Client Secret" fields
# 3. In ChatGPT, select "OAuth" authentication and trust the application
# 4. ChatGPT will use Authorization Code + PKCE flow to authenticate
